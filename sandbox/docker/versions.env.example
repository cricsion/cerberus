# Pinned versions for the scan sandbox image (harness/sandbox/docker/build.sh).
# Fill in and keep updated: every value is a build ARG, and the two release
# binaries are sha256-verified at build (mismatch = failed build, not silent
# drift). Get current values with:
#   gh release view gitleaks/gitleaks --json tagName -q .tagName
#   gh release view google/osv-scanner --json tagName -q .tagName   # 1.x line
#   gh release view opengrep/opengrep --json tagName -q .tagName   # then sha256 the
#     opengrep_manylinux_x86 asset (the image installs the release binary:
#     building from source installs no `opengrep` entry point)
#   pip index versions semgrep | head -1
#   pip index versions checkov | head -1
#
# WARNING: values below are PLACEHOLDERS from when this file was written.
# Verify each against the command above before your first build; a wrong
# version (or empty checksum) fails the build closed-by-design.
GITLEAKS_VERSION=8.28.0
GITLEAKS_SHA256=
OSV_SCANNER_VERSION=1.9.2
OSV_SCANNER_SHA256=
SEMGREP_VERSION=1.136.0
OPENGREP_VERSION=1.30.2
OPENGREP_SHA256_X86=          # sha256 of the release asset opengrep_manylinux_x86
OPENGREP_SHA256_AARCH64=     # sha256 of the release asset opengrep_manylinux_aarch64
CHECKOV_VERSION=3.2.471

PWNTOOLS_VERSION=
CAPSTONE_VERSION=             # must stay <5: binwalk 2.3.4 needs CS_ARCH_ARM64
BINWALK_VERSION=
FFUF_VERSION=
FFUF_SHA256_X64=               # sha256 of ffuf_<v>_linux_amd64.tar.gz
FFUF_SHA256_ARM64=             # sha256 of ffuf_<v>_linux_arm64.tar.gz
NUCLEI_VERSION=
NUCLEI_SHA256_X64=             # sha256 of nuclei_<v>_linux_amd64.zip
NUCLEI_SHA256_ARM64=           # sha256 of nuclei_<v>_linux_arm64.zip
HTTPX_VERSION=
HTTPX_SHA256_X64=              # sha256 of httpx_<v>_linux_amd64.zip
HTTPX_SHA256_ARM64=            # sha256 of httpx_<v>_linux_arm64.zip
KATANA_VERSION=
KATANA_SHA256_X64=             # sha256 of katana_<v>_linux_amd64.zip
KATANA_SHA256_ARM64=           # sha256 of katana_<v>_linux_arm64.zip
GAU_VERSION=
GAU_SHA256_X64=                # sha256 of gau_<v>_linux_amd64.tar.gz
GAU_SHA256_ARM64=              # sha256 of gau_<v>_linux_arm64.tar.gz
SQLMAP_VERSION=
ARJUN_VERSION=
MITMPROXY_VERSION=             # <=11.0.2: 11.1+ requires Python >=3.12, image pins 3.11

# Opt-in toolchains: set to 1 only when targets need their test suites.
# Node is ON here because the code-graph indexer lane needs the codegraph CLI,
# which rides this opt-in. NODE_VERSION must be >= 22.5 (node:sqlite).
WITH_NODE=1
NODE_VERSION=22
WITH_GO=0
GO_VERSION=
# codegraph CLI: the code-graph indexer lane (harness/codegraph/_index.py) runs
# it in the container. Pinned like every other tool; npm registry integrity
# stands in for a sha256 binary (no standalone tarball exists). Required by
# build.sh even when WITH_NODE=0, so the key must be present in versions.env.
#   npm view @colbymchenry/codegraph version
CODEGRAPH_VERSION=1.6.2
SEMGREP_RULES_REV=
