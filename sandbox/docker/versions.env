# Pinned versions for the scan sandbox image (cerberus/sandbox/docker/build.sh).
# Every value is a build ARG; the release binaries are sha256-verified at build
# (mismatch = failed build, not silent drift). Binaries are per-arch: an x64-only
# binary crashes under qemu on arm64 hosts, so each tool takes the asset for the
# build's TARGETARCH (amd64 / arm64).
#   -- build-arg GITLEAKS_VERSION=8.30.1 GITLEAKS_SHA256_X64=<sha of
#        gitleaks_<v>_linux_x64.tar.gz> GITLEAKS_SHA256_ARM64=<...linux_arm64.tar.gz>
#   -- osv-scanner stays on the 1.x line: cerberus/tools/sast.py and the
#      in-image skill encode the v1 CLI/API contract, and v2 changes the CLI
#      surface. Offline-DB support was NOT dropped by v2 (v2 promoted offline
#      scanning): OSV_SCANNER_VERSION=1.9.2
# Base image: the one digest-pinned input. Use the manifest-list digest so
# amd64+arm64 both resolve; refresh deliberately, like every other pin, from
#   docker buildx imagetools inspect python:3.11-slim-bookworm   # -> Digest:
PYTHON_BASE_IMAGE=python:3.11-slim-bookworm@sha256:f06d01d4ba3f8ad5af45a3ec87df19c1d317d8e8961edc0fabda61811af6f7cf
GITLEAKS_VERSION=8.30.1
GITLEAKS_SHA256_X64=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
GITLEAKS_SHA256_ARM64=e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080
OSV_SCANNER_VERSION=1.9.2
OSV_SCANNER_SHA256_X64=d6af4b67fa5de658598bd2d445efb99e90d1734b3146962418719c4350ecb74b
OSV_SCANNER_SHA256_ARM64=9c6160afb26c79449a1f1b667323b989a57dda8fc19f22936c9ff920fd97ddfa
SEMGREP_VERSION=1.172.0
OPENGREP_VERSION=1.30.2
OPENGREP_SHA256_X64=a66aa3278457f02b287b985a45b6762aebcaba5000f2689245fd1ed86d1456c7
OPENGREP_SHA256_ARM64=90acea5df4b733083f388d4feeb250ca802f671b33d1f222653d1e571dd2b0d8
CHECKOV_VERSION=3.3.26
# Bandit is a pip package (no sha256 plumbing -- same install/verify story as
# semgrep and checkov above).
BANDIT_VERSION=1.9.4
# Bearer: binary release tarballs.
BEARER_VERSION=2.1.1
BEARER_SHA256_X64=6b79d315577fea8305dfe08577bea6ad53852a929cd24de9211d39750a194bbb
BEARER_SHA256_ARM64=ef05756d374aeb179534e1bb441cd2c3bd56b8fcf21c693d71078859c6721916
# Trufflehog: verified-secret detection incl. git history; current-tree only
# by default (--no-update, no history scan) to stay in gitleaks' time budget.
TRUFFLEHOG_VERSION=3.99.2
TRUFFLEHOG_SHA256_X64=3c7b0d1dc4278294269bfdd7594bca8bb28c78da0a4a06ad202ded37b48deca4
TRUFFLEHOG_SHA256_ARM64=929b81efffca752eafd58bf6f17bf725d354f338636a7bbbee65c086d2f9ddf3
# gosec: Go security specialist (bandit's Go counterpart). Static binary.
GOSEC_VERSION=2.29.0
GOSEC_SHA256_X64=6431b119741c1f4a50fdfcf94e782e16b9e642afc8c7fa9b5d39d48bf3003095
GOSEC_SHA256_ARM64=c71244ec8d37488fd479d0d26990968fee03ece48b305d8224ac0c1ebd66e87c
# Language/tooling adds that ride the pip line (no sha256 plumbing, same
# install/verify story as semgrep/checkov/bandit):
#   flawfinder = C/C++ pattern checks with CWE tags (native-code breadth)
FLAWFINDER_VERSION=2.0.20
# Atheris 3.0.0 matches the image's Python 3.11 and Semgrep's supported
# interpreter range. PyPI has x86_64 wheels only; arm64 builds from source,
# so the Dockerfile installs Clang/compiler-rt and sets CLANG_BIN.
# Its Setup/Fuzz/instrument_func API and CLI flags
# (-runs=/-atheris_runs=/-artifact_prefix=) match the Atheris skill.
ATHERIS_VERSION=3.0.0
# njsscan rides the SHARED pip line: the image semgrep pin IS njsscan's own
# pin (njsscan 1.0.1 hard-pins semgrep==1.172.0, verbatim, no middle version),
# so one shared dependency tree serves both tools — no isolation, no wrapper.
# Node.js is not a dependency of njsscan.
NJSSCAN_VERSION=1.0.1
PWNTOOLS_VERSION=4.15.0
CAPSTONE_VERSION=4.0.2  # <5: binwalk needs CS_ARCH_ARM64
SQLMAP_VERSION=1.10.10
ARJUN_VERSION=2.2.7

BINWALK_VERSION=2.3.4
BINWALK_SHA256=60416bfec2390cec76742ce942737df3e6585c933c2467932f59c21e002ba7a9
FFUF_VERSION=2.3.0
FFUF_SHA256_X64=b2a3c725fcb9da175159682f54d6e9149f2905b00d84d155e7efc5d599975ceb
FFUF_SHA256_ARM64=e2d712615d53da797ee929006e41f2df5a7960a5353133db9c150ddaa22ae4e8
NUCLEI_VERSION=3.11.1
NUCLEI_SHA256_X64=ea63d4ae232808cd7c6bc00d0142428e231fab59dae01042246097d195835ab6
NUCLEI_SHA256_ARM64=8044e3d9768ba0a744b2872c1a87e813006f013da97ca9f50f7661a4203bec07
HTTPX_VERSION=1.12.0
HTTPX_SHA256_X64=9d8439e8b6c9aa7d1e2314817a392e00d5178da3af5652f7475f88868f418f76
HTTPX_SHA256_ARM64=fd7b123c1dfbc3d69f19f524e4eebcd6ec06b9a6cbd56813c76f11645197331e
KATANA_VERSION=1.8.0
KATANA_SHA256_X64=cb027ae99d0757061b70c07a15c7a80f62c5a535ab52c4a329f80c4b0a7309d2
KATANA_SHA256_ARM64=80e269210727a855511ffac8dfb01297b2344742acec71a35e8ba4a67a90f0f2
GAU_VERSION=2.2.4
GAU_SHA256_X64=10e2e248c37cafb0be3f6d2931125296b95cd4186066d596d47fa417237529a9
GAU_SHA256_ARM64=c194992df360d3a24e021c6dc5a5a0576cfd769be1d19cccb29adc1d3759637d
MITMPROXY_VERSION=11.0.2

WITH_NODE=1
NODE_VERSION=22
WITH_GO=0
GO_VERSION=
# codegraph CLI: the code-graph indexer lane (cerberus/codegraph/_index.py) runs
# it in the container. Pinned like every other tool; npm registry integrity
# stands in for a sha256 binary (no standalone tarball exists). Required by
# build.sh even when WITH_NODE=0. To actually bake it in, set WITH_NODE=1 and
# NODE_VERSION=22 (>= 22.5: the CLI reads its DB via node:sqlite).
CODEGRAPH_VERSION=1.6.2

SEMGREP_RULES_REV=16b9e6d45f10649f6a531ec4838ed9924372c3bc
