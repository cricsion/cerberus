# Pinned versions for the scan sandbox image (cerberus/sandbox/docker/build.sh).
# Every value is a build ARG. Binaries are per-arch: an x64-only
# binary crashes under qemu on arm64 hosts, so each tool takes the asset for the
# build's TARGETARCH (amd64 / arm64).
#   -- build-arg GITLEAKS_VERSION=8.30.1
#   -- osv-scanner stays on the 1.x line: cerberus/tools/sast.py and the
#      in-image skill encode the v1 CLI/API contract, and v2 changes the CLI
#      surface. Offline-DB support was NOT dropped by v2 (v2 promoted offline
#      scanning): OSV_SCANNER_VERSION=1.9.2
# Base image: the manifest-list tag resolves for both amd64+arm64.
PYTHON_BASE_IMAGE=python:3.11-slim-bookworm
GITLEAKS_VERSION=8.30.1
OSV_SCANNER_VERSION=1.9.2
SEMGREP_VERSION=1.172.0
OPENGREP_VERSION=1.30.2
CHECKOV_VERSION=3.3.26
# Bandit is a pip package (same install story as semgrep and checkov above).
BANDIT_VERSION=1.9.4
# Bearer: binary release tarballs.
BEARER_VERSION=2.1.1
# Trufflehog: verified-secret detection incl. git history; current-tree only
# by default (--no-update, no history scan) to stay in gitleaks' time budget.
TRUFFLEHOG_VERSION=3.99.2
# gosec: Go security specialist (bandit's Go counterpart). Static binary.
GOSEC_VERSION=2.29.0
# Language/tooling adds that ride the pip line (same install story as
# semgrep/checkov/bandit):
#   flawfinder = C/C++ pattern checks with CWE tags (native-code breadth)
FLAWFINDER_VERSION=2.0.20
# Atheris 3.0.0 matches the image's Python 3.11 and Semgrep's supported
# interpreter range. PyPI has x86_64 wheels only; arm64 builds from source,
# so the Dockerfile installs Clang/compiler-rt and sets CLANG_BIN.
# Its Setup/Fuzz/instrument_func API and CLI flags
# (-runs=/-atheris_runs=/-artifact_prefix=) match the Atheris skill.
ATHERIS_VERSION=3.0.0
# njsscan rides the SHARED pip line: the image semgrep pin IS njsscan's own
# pin (njsscan 1.0.1 hard-pins semgrep==1.172.0, verbatim, no middle version),
# so one shared dependency tree serves both tools — no isolation, no wrapper.
# Node.js is not a dependency of njsscan.
NJSSCAN_VERSION=1.0.1
PWNTOOLS_VERSION=4.15.0
CAPSTONE_VERSION=4.0.2  # <5: binwalk needs CS_ARCH_ARM64
SQLMAP_VERSION=1.10.10
ARJUN_VERSION=2.2.7

BINWALK_VERSION=2.3.4
FFUF_VERSION=2.3.0
NUCLEI_VERSION=3.11.1
HTTPX_VERSION=1.12.0
KATANA_VERSION=1.8.0
GAU_VERSION=2.2.4
MITMPROXY_VERSION=11.0.2

WITH_NODE=1
NODE_VERSION=22
WITH_GO=0
GO_VERSION=
# codegraph CLI: the code-graph indexer lane (cerberus/codegraph/_index.py) runs
# it in the container. Pinned like every other tool; npm registry integrity
# stands in for a sha256 binary (no standalone tarball exists). Required by
# build.sh even when WITH_NODE=0. To actually bake it in, set WITH_NODE=1 and
# NODE_VERSION=22 (>= 22.5: the CLI reads its DB via node:sqlite).
CODEGRAPH_VERSION=1.6.2

SEMGREP_RULES_REV=16b9e6d45f10649f6a531ec4838ed9924372c3bc
