        {
          "ruleId": "CWE-285",
          "level": "error",
          "message": {
            "text": "Broken function-level authorization in UserDelete.delete() (conf 0.95)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "server/api/v1/api_v1.py"
                },
                "region": {
                  "startLine": 232,
                  "endLine": 232,
                  "snippet": {
                    "text": "cursor.execute(\"DELETE FROM users WHERE id = ?\", (user_id,))"
                  }
                }
              }
            }
          ],
          "properties": {
            "security-severity": "8.8",
            "cvssVector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H",
            "pocStatus": "planned",
            "reproduced": false,
            "patchSummary": "Require @token_required plus admin-role check before DELETE, and never allow self-deletion of last admin without confirmation"
          },
