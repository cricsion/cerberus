# Copy to harness/.env and fill in. Never commit .env.
# Every value here also has a harness/config/default.yaml default (interpolated from
# these same names); env wins unless the YAML pins it.

BASE_URL=http://localhost:8000/v1
API_KEY=changeme

# --- models (role defaults; per-agent keys in config override these) --------
HUNTER_MODEL=hunter
VALIDATOR_MODEL=validator
# Per-agent overrides (empty = fall back to the role model above):
TRIAGER_MODEL=
PARTITIONER_MODEL=
THREAT_MODEL=

# --- thinking effort: low | medium | high | xhigh | max ---------------------
EFFORT=max
HUNTER_EFFORT=
VALIDATOR_EFFORT=
TRIAGER_EFFORT=
PARTITIONER_EFFORT=
THREAT_EFFORT=

# --- LLM call budgets --------------------------------------------------------
# Per-call read/write timeout (seconds).
HARNESS_TIMEOUT=600
# Retries per call.
HARNESS_MAX_RETRIES=3
# Cap on SDK retry backoff (seconds).
HARNESS_RETRY_SLEEP_CAP=2
# Model-call budget per agent run.
MODEL_CALL_LIMIT=1000
# Connect-leg timeout (seconds); the read/write legs use HARNESS_TIMEOUT.
HARNESS_CONNECT_TIMEOUT=10

# --- fan-out -----------------------------------------------------------------
# Max parallel agents (hunters, validator pool, triage batches). Clamped 1-32.
CONCURRENCY=8
# Minimum files for a partition group to stand alone (smaller groups merge up).
MIN_FILES=10

# --- partition edge-scan caps (harness/partitioning/graph.py) ----------------
# Files over the byte cap, and reads past the total cap, contribute no
# framework edges (render/config/barrel/same-dir) to the partition graph.
# Raise only when real source files exceed the caps; vendor dirs stay excluded.
# PARTITION_EDGE_MAX_FILE_BYTES=262144
# PARTITION_EDGE_READ_CAP_BYTES=20000000

# --- triage ------------------------------------------------------------------
# Max findings per triage LLM call (0 = unlimited).
# TRIAGE_BATCH=30

# --- tool output caps (optional; defaults in harness/config/default.yaml) ------------
# CODEGRAPH_CHARS=20000          # codegraph report cap; 0 = unlimited
# CODEGRAPH_CANDIDATES=200       # blind-spot candidate rows per call
# GRAPH_CHARS=20000              # graphify report cap; 0 = unlimited
# SAST_BYTES=200000              # scanner stdout cap (same budget as sandbox capture)
# SAST_FINDINGS=5000             # SAST template/finding rows
# SAST_SUMMARIES_DB=             # absolute path for the summary sidecar

# --- sandbox (optional; defaults in harness/config/default.yaml) ---------------------
# SANDBOX_BACKEND=local            # local | docker
# SANDBOX_COMMAND_TIMEOUT=120
# SANDBOX_MAX_OUTPUT_BYTES=200000
# SANDBOX_RESET_AGENT_SCRATCH=1     # wipe per-agent scratch between hunters and verifiers
# SANDBOX_SWEEP_ORPHANS=1           # reap sandboxes a killed run left behind, at scan start
# docker backend:
# SANDBOX_IMAGE=cyber-sandbox:local
# SANDBOX_NETWORK=bridge             # none (fail closed) | bridge (full egress)
# SANDBOX_MEMORY=2g
# SANDBOX_CPUS=2
# SANDBOX_PIDS_LIMIT=512
