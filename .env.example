# Copy to cerberus/.env and fill in. Never commit .env.
# Every value here also has a cerberus/config/default.yaml default (interpolated
# from these same names); env wins unless the YAML pins it. Names not in this
# file but in the shipped default.yaml (partition policy, sandbox limits, ...)
# are still env-overridable -- the canonical list is the `${VAR:-...}` set in
# default.yaml.

# --- endpoint + key (required) ----------------------------------------------
# BASE_URL is any OpenAI-compatible endpoint. API_KEY is the key the harness
# sends there. Point them at whatever router/provider you use; the code reads API_KEY/BASE_URL itself.
BASE_URL=http://localhost:8000/v1
API_KEY=changeme

# --- models (role defaults; per-agent keys in config override these) --------
HUNTER_MODEL=hunter
VALIDATOR_MODEL=validator
# Per-agent overrides (empty = fall back to the role model above):
TRIAGER_MODEL=
PARTITIONER_MODEL=
THREAT_MODEL=
POC_MODEL=

# --- thinking effort: low | medium | high | xhigh | max ---------------------
EFFORT=medium
HUNTER_EFFORT=
VALIDATOR_EFFORT=
TRIAGER_EFFORT=
PARTITIONER_EFFORT=
THREAT_EFFORT=
POC_EFFORT=

# --- LLM call budgets -------------------------------------------------------
# Per-call read/write timeout (seconds).
TIMEOUT=600
# Retries per call.
MAX_RETRIES=3
# Cap on SDK retry backoff (seconds).
RETRY_SLEEP_CAP=2
# Connect-leg timeout (seconds); the read/write legs use TIMEOUT.
CONNECT_TIMEOUT=10
# Model-call budget per agent run.
# MODEL_CALL_LIMIT=16000
# Per-run LangGraph superstep cap.
# RECURSION_LIMIT=64000

# --- model-profile pins ------------------------------------------------------
# A model behind a custom base_url carries no profile, so deepagents would
# fall back to its summarization trigger. Max input tokens calibrate context
# compression; structured_output forces the method (json_schema | function_calling)
# if the backend supports it.
# MODEL_MAX_INPUT_TOKENS=400000
# MODEL_STRUCTURED_OUTPUT=

# --- fan-out -----------------------------------------------------------------
# Max parallel agents (hunters, validator pool, triage batches).
# Any positive int; no upper clamp.
CONCURRENCY=8
# Extra discovery reruns, shared by unit hunters AND the system pass.
# 0 = one pass each. N = N additional fresh agent sessions per pass,
# seeded with everything already reported and asked for additional
# findings only; early-stops after two consecutive empty passes.
# Default: 2. Any non-negative int.
# RERUNS=2
# Minimum files for a partition group to stand alone (smaller groups merge up).
# MIN_FILES=10

# --- partition (cerberus/partitioning) --------------------------------------
# enable_agent: LLM-assisted partitioning (default false = deterministic).
# PARTITION_ENABLE_AGENT=false
# Part units by file BYTES (stat-only, no reads): loc_budget x bytes_per_loc.
# PARTITION_LOC_BUDGET=10000
# PARTITION_BYTES_PER_LOC=40
# Hard cap on hunter units (0 = unlimited).
# MAX_UNITS=20
# PARTITION_SINGLE_UNIT_MAX_FILES=1000
# PARTITION_MISC_CODE_MERGE=1
# PARTITION_FRAMEWORK_EDGES=1
# PARTITION_VENDOR_UNIT=1

# --- codegraph + tool output caps --------------------------------------------
# CODEGRAPH_CHARS=20000          # codegraph report cap; 0 = unlimited
# CODEGRAPH_CANDIDATES=200       # blind-spot candidate rows per call
# CODEGRAPH_PARTITION_MODE=primary   # primary | off (deterministic dir units)
# SAST_FINDINGS=5000             # SAST template/finding rows cap

# --- triage ------------------------------------------------------------------
# Max findings per triage LLM call.
# TRIAGER_BATCH=100

# --- validator pool / PoC -----------------------------------------------------
# Findings per validator cell (verification + poc share CELL_SIZE).
# CELL_SIZE=15
# Votes per finding (1 = single verdict, majority style).
# VERIFIER_VOTES=1
# VERIFIER_COUPLE_REMAINDERS=0
# POC_ENABLED=1
# POC_REPRO_RUNS=3
# POC_TIMEOUT=600

# --- sandbox -----------------------------------------------------------------
# local = repo-confined file tools only (no shell). docker = agents get an
# `execute` shell in ONE shared run container (repo read-only, shared scratch).
# SANDBOX_BACKEND=local
# SANDBOX_IMAGE=cerberus-sandbox:local
# SANDBOX_PULL_IMAGE=0
# SANDBOX_DOCKER_BIN=docker
# Network policy: bridge = full egress; none = no network. `host` is refused.
# SANDBOX_NETWORK=bridge
# SANDBOX_MAX_OUTPUT_BYTES=200000
# SANDBOX_COMMAND_TIMEOUT=120
# Shared run-container budget:
# SANDBOX_MEMORY=2g
# SANDBOX_CPUS=2
# SANDBOX_PIDS_LIMIT=512
# Hygiene knobs (no-op in local mode):
# SANDBOX_RESET_AGENT_SCRATCH=1
# SANDBOX_SWEEP_ORPHANS=1

# --- observability (optional) -------------------------------------------------
# Tracing auto-enables when all three LANGFUSE_* values are set; no-op otherwise.
# LANGFUSE_ENABLED=auto
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# --- ui -----------------------------------------------------------------------
# Heartbeat update interval (seconds) for the TUI run view.
# HEARTBEAT_S=5
